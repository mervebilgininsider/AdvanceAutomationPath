{
  "dashboard": {
    "id": null,
    "title": "UI Test Metrics - PostgreSQL",
    "tags": ["testing", "selenium", "postgresql"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Total Tests",
        "type": "stat",
        "targets": [
          {
            "rawSql": "SELECT COUNT(*) as value FROM test_results",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Passed Tests",
        "type": "stat",
        "targets": [
          {
            "rawSql": "SELECT COUNT(*) as value FROM test_results WHERE status = 'passed'",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Failed Tests",
        "type": "stat",
        "targets": [
          {
            "rawSql": "SELECT COUNT(*) as value FROM test_results WHERE status = 'failed'",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                }
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
      }
    ],
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "refresh": "30s"
  }
}
